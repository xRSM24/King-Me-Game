{
  "name": "jumpgrave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "publish": "node scripts/publish.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "tsc --noEmit && node --experimental-strip-types src/game/crownCheck.ts && node scripts/namesCheck.mjs",
    "sync": "npm run icons && npm run build && npx cap sync && node scripts/patch-native.mjs",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "sharp": "^0.34.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@fontsource/mochiy-pop-one": "^5.2.5",
    "@fontsource/zen-maru-gothic": "^5.2.5",
    "@netlify/blobs": "^11.0.2"
  }
}
